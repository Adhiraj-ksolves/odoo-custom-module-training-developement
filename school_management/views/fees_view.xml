<odoo>
    <data>

        <record id="action_school_fees" model="ir.actions.act_window">
            <field name="name">Fees</field>
            <field name="res_model">school.management.fees</field>
            <field name="view_mode">list,form</field>
            <field name="type">ir.actions.act_window</field>
        </record>

        <record id="view_school_fees_list" model="ir.ui.view">
            <field name="name">school.fees.list</field>
            <field name="model">school.management.fees</field>
            <field name="arch" type="xml">
                <list>
                    <field name="student_id"/>
                    <field name="amount"/>
                    <field name="due_date"/>
                    <field name="paid"/>
                </list>
            </field>
        </record>

        <record id="view_school_fees_form" model="ir.ui.view">
            <field name="name">school.fees.form</field>
            <field name="model">school.management.fees</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="student_id"/>
                            <field name="amount"/>
                            <field name="due_date"/>
                            <field name="paid"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
