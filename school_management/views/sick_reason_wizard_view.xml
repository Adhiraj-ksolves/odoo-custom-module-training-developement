<odoo>
    <record id="action_sick_reason_wizard" model="ir.actions.act_window">
        <field name="name">Sick Reason for student</field>
        <field name="res_model">student.sick.reason.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_sick_reason_wizard_form" model="ir.ui.view">
        <field name="name">student.sick.reason.wizard.form</field>
        <field name="model">student.sick.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Sick Reason">
                <group>
                    <field name="sick_reason"/>
                </group>
                <group>
                    <field name="sick_date"/>
                </group>
                <group>
                    <field name="guardian_contact"/>
                </group>
                <group>
                    <field name="notes"/>
                </group>
                <footer>
                    <button name="action_confirm_reason" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
