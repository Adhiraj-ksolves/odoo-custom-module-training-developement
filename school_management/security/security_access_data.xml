<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="rule_teacher_see_their_students" model="ir.rule">
        <field name="name">Teachers can only see their students</field>
        <field name="model_id" ref="model_school_management_student"/>
        <field name="domain_force">[('teacher_ids.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('school_management.group_teacher'))]"/>
    </record>
</odoo>